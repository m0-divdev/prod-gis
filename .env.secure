DATABASE_URL="postgresql://postgres:postgres@localhost:5432/foursquare_db?schema=public"
NODE_ENV=development
PORT=4000

# JWT Configuration - CRITICAL: Use a strong secret in production
# Must be 32+ characters with mixed case, numbers, and special characters
