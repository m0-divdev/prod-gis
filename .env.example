# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/foursquare_db"

# JWT Configuration (SECURITY CRITICAL)
# JWT_SECRET must be at least 32 characters with mixed case, numbers, and special characters
# Example: "MyStr0ng$ecureJWT$ecret!@#ForAuth2024*&^%"
JWT_SECRET="your-super-secure-jwt-secret-at-least-32-characters-with-mixed-case-numbers-and-special-chars"
ACCESS_TOKEN_EXPIRY_HOURS=3
REFRESH_TOKEN_EXPIRY_DAYS=7

# Redis Configuration (for caching and rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# External API Keys
TOMTOM_API_KEY=your_tomtom_api_key
GOOGLE_API_KEY=your_google_api_key
OPENWEATHER_API_KEY=your_openweather_api_key
PREDICTHQ_API_KEY=your_predicthq_api_key
BESTTIME_API_KEY=your_besttime_api_key
IPSTACK_API_KEY=your_ipstack_api_key

# Application Configuration
PORT=3000
NODE_ENV=development
DEFAULT_USER_BALANCE=100.0

# CORS Configuration (Production)
# Comma-separated list of allowed origins for production
ALLOWED_ORIGINS="https://yourapp.com,https://www.yourapp.com"

# Rate Limiting Configuration (Optional - uses defaults if not set)
RATE_LIMIT_SHORT_TTL=1000
RATE_LIMIT_SHORT_LIMIT=3
RATE_LIMIT_MEDIUM_TTL=10000
RATE_LIMIT_MEDIUM_LIMIT=20
RATE_LIMIT_LONG_TTL=60000
RATE_LIMIT_LONG_LIMIT=100

# Security Headers (Optional - uses secure defaults if not set)
SECURITY_FRAME_OPTIONS=DENY
SECURITY_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_XSS_PROTECTION="1; mode=block"

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
ENABLE_SWAGGER_DOCS=true
ENABLE_HEALTH_CHECKS=true
ENABLE_DETAILED_ERRORS=false
