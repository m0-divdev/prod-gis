// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

model User {
  id            String         @id @default(cuid())
  walletAddress String         @unique
  username      String?
  status        UserStatus     @default(ACTIVE)
  credits       Credits?
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletAddress])
  @@index([status])
}

model Credits {
  id               String  @id @default(cuid())
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String  @unique
  availableCredits Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   // Removed @unique to allow multiple tokens per user
  token     String   @unique
  deviceId  String?  // Optional device identifier for session management
  userAgent String?  // Optional user agent for session tracking
  ipAddress String?  // Optional IP address for security monitoring
  isRevoked Boolean  @default(false) // For token revocation
  expiresAt DateTime
  lastUsed  DateTime? // Track when token was last used
  updatedAt DateTime @updatedAt

  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
  @@index([userId])
  @@index([isRevoked])
}

model Place {
  id        Int      @id @default(autoincrement())
  fsq_id    String   @unique
  name      String?
  lat       Float?
  lon       Float?
  raw       Json? // store full FSQ JSON if needed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fsq_id])
}
